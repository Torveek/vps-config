#!/usr/bin/env bash
# ==============================================================================
# VPS Ubuntu Server Configuration - Environment & Default Settings
# Supported Versions: Ubuntu 22.04 LTS (Jammy) and Ubuntu 24.04 LTS (Noble)
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="${SCRIPT_DIR}/dotfiles"
LIB_DIR="${SCRIPT_DIR}/lib"

# --- SSH Defaults ---
DEFAULT_SSH_PORT=2222
SSHD_CONFIG="/etc/ssh/sshd_config"
SSHD_CONFIG_D="/etc/ssh/sshd_config.d"

# --- Zsh & Oh My Zsh ---
OMZ_REPO="https://github.com/ohmyzsh/ohmyzsh.git"
ZSH_CUSTOM_PLUGINS=(
  "zsh-autosuggestions:https://github.com/zsh-users/zsh-autosuggestions.git"
  "zsh-syntax-highlighting:https://github.com/zsh-users/zsh-syntax-highlighting.git"
  "command-time:https://github.com/popstas/zsh-command-time.git"
)

# --- Starship & Zoxide ---
STARSHIP_INSTALLER_URL="https://starship.rs/install.sh"
ZOXIDE_INSTALLER_URL="https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh"

# --- Neovim ---
# Latest stable Neovim binary release (ensures modern LazyVim >= 0.11.2 compatibility)
NEOVIM_VERSION="latest"
NEOVIM_FALLBACK_VERSION="v0.12.6"
NEOVIM_INSTALL_DIR="/opt/nvim"

# --- Fresh Text Editor ---
FRESH_REPO_URL="https://github.com/sinelaw/fresh"
FRESH_INSTALLER_URL="https://raw.githubusercontent.com/sinelaw/fresh/master/scripts/install.sh"
FRESH_DEFAULT_VERSION="v0.5.3"

# --- Lazydocker ---
LAZYDOCKER_INSTALLER_URL="https://raw.githubusercontent.com/jesseduffield/lazydocker/master/scripts/install_update_linux.sh"

# --- Charm Gum Repo ---
CHARM_GPG_URL="https://repo.charm.sh/apt/gpg.key"
CHARM_REPO_URL="https://repo.charm.sh/apt/"
CHARM_KEYRING="/etc/apt/keyrings/charm.gpg"
CHARM_LIST="/etc/apt/sources.list.d/charm.list"

# --- Docker ---
DOCKER_GPG_URL="https://download.docker.com/linux/ubuntu/gpg"
DOCKER_KEYRING="/etc/apt/keyrings/docker.gpg"
DOCKER_LIST="/etc/apt/sources.list.d/docker.list"

# --- Caddy ---
CADDY_GPG_URL="https://dl.cloudsmith.io/public/caddy/stable/gpg.key"
CADDY_DEB_LIST_URL="https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt"
CADDY_KEYRING="/usr/share/keyrings/caddy-stable-archive-keyring.gpg"
CADDY_LIST="/etc/apt/sources.list.d/caddy-stable.list"
